#!/usr/bin/env bash

# Opens the calendar in a properly configured floating terminal.
# In Hyprland the float/size/center rules are applied one-shot at spawn time,
# so nothing accumulates in the compositor's global windowrule list.

set -o nounset
set -o pipefail

# Determine the calendar script location
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "${SCRIPT_DIR}/lvsk-calendar" ]]; then
    # Running from development directory
    CALENDAR_SCRIPT="${SCRIPT_DIR}/lvsk-calendar"
else
    # Running from installed package
    CALENDAR_SCRIPT="/usr/bin/lvsk-calendar"
fi

if [[ ! -x "${CALENDAR_SCRIPT}" ]]; then
    printf 'lvsk-calendar-launcher: calendar not found at %s\n' "${CALENDAR_SCRIPT}" >&2
    exit 1
fi

# Detect terminal emulator and build the launch command with proper title.
# LAUNCHED_BY_LAUNCHER tells the calendar to close the terminal window on exit.
declare -a term_cmd=()
if command -v ghostty &>/dev/null; then
    term_cmd=(ghostty --title=lvsk-calendar -e env LAUNCHED_BY_LAUNCHER=1 "${CALENDAR_SCRIPT}")
elif command -v kitty &>/dev/null; then
    term_cmd=(kitty --title=lvsk-calendar -e env LAUNCHED_BY_LAUNCHER=1 "${CALENDAR_SCRIPT}")
elif command -v alacritty &>/dev/null; then
    term_cmd=(alacritty --title=lvsk-calendar -e env LAUNCHED_BY_LAUNCHER=1 "${CALENDAR_SCRIPT}")
elif command -v foot &>/dev/null; then
    term_cmd=(foot --title=lvsk-calendar env LAUNCHED_BY_LAUNCHER=1 "${CALENDAR_SCRIPT}")
elif command -v wezterm &>/dev/null; then
    term_cmd=(wezterm start --class lvsk-calendar -- env LAUNCHED_BY_LAUNCHER=1 "${CALENDAR_SCRIPT}")
else
    printf 'lvsk-calendar-launcher: no supported terminal emulator found (ghostty, kitty, alacritty, foot, wezterm)\n' >&2
    exit 1
fi

# Quote a string as a Lua literal for hl.dsp.exec_cmd(). Only backslash and
# double quote need escaping: the spawn line is built by printf %q and never
# contains a newline.
lua_quote() {
    local value="${1//\\/\\\\}"
    printf '"%s"' "${value//\"/\\\"}"
}

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl &>/dev/null; then
    # One-shot window rules: float/size/center apply only to this spawn,
    # regardless of terminal, title or class - and leave no global state behind
    printf -v cmd_str '%q ' "${term_cmd[@]}"
    spawn="[float; size 600 500; center] ${cmd_str}"

    # Hyprland 0.56 (Omarchy Quattro) evaluates `hyprctl dispatch` arguments as
    # Lua, so the bracketed rule string has to travel inside exec_cmd or the
    # dispatch dies on a parse error. Older Hyprland has no Lua API and still
    # takes the bare dispatcher form, so keep it as the fallback.
    if reply=$(hyprctl dispatch "hl.dsp.exec_cmd($(lua_quote "${spawn}"))" 2>&1) &&
        [[ -z ${reply} || ${reply} == "ok" ]]; then
        exit 0
    fi

    exec hyprctl dispatch exec "${spawn}" >/dev/null
fi

exec "${term_cmd[@]}"
